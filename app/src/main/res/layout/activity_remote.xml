<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/text_remote_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#172033"
                android:gravity="center"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/text_remote_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:textSize="14sp"
                android:textColor="#667085"
                android:gravity="center"
                android:padding="10dp" />

            <Button
                android:id="@+id/btn_power"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/btn_power"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_temp_down"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:text="@string/btn_temp_down"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_temp_up"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_temp_up"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_mode_cycle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_mode_cycle" />

            <Button
                android:id="@+id/btn_fan_cycle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_fan_cycle" />

            <Button
                android:id="@+id/btn_swing_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_swing_toggle" />

            <Button
                android:id="@+id/btn_schedule"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:text="@string/btn_schedule"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_change_device"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:text="@string/btn_change_device" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>